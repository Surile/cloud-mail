        return;
      }
      if (verdict?.decision === "reject") {
        await this.rejectByAi(c3, applyRow, verdict.reason);
        await this.notify(c3, applyRow, "ai-rejected");
        return;
      }
    }
    await this.notify(c3, applyRow, "pending");
  },
  // 返回 true=开通成功；false=失败回落（留待审或作废）
  async approveWithFallback(c3, applyRow, mode, silent) {
