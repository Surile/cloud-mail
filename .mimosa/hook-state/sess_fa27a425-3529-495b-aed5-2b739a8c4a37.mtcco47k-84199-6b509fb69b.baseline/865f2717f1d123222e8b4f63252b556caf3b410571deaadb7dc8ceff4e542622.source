    if (c3.cron === "*/30 * * * *") {
      await analysis_service_default.refreshEchartsCache({ env });
      return;
    }
    await verify_record_service_default.clearRecord({ env });
    await user_service_default.resetDaySendCount({ env });
    await email_service_default.completeReceiveAll({ env });
    await email_service_default.autoClean({ env });
