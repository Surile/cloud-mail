  generateApplyToken(c3, oauthUserId) {
    return jwt_utils_default.generateToken(c3, { type: "apply", oauthUserId }, APPLY_JWT_EXPIRE);
  },
  async getSettingRow(c3) {
    return await orm(c3).select().from(setting_default).get();
  },
  async verifyApplyToken(c3, token2) {
    if (!token2) {
      throw new biz_error_default(t3("applyIdentityFail"), 401);
    }
    const payload = await jwt_utils_default.verifyToken(c3, token2);
    if (!payload || payload.type !== "apply" || !payload.oauthUserId) {
      throw new biz_error_default(t3("applyIdentityFail"), 401);
    }
    const oauthRow = await orm(c3).select().from(oauth).where(eq(oauth.oauthUserId, payload.oauthUserId)).get();
    if (!oauthRow) {
      throw new biz_error_default(t3("applyIdentityFail"), 401);
    }
    return { payload, oauthRow };
  },
  async submit(c3, params) {
    const email4 = params.email;
    const reasonText = String(params.reason || "").trim();
    const verified = await this.verifyApplyToken(c3, params.token);
    const oauthRow = verified.oauthRow;
    if (oauthRow.userId !== 0) {
      throw new biz_error_default(t3("oauthBound"));
    }
    const intakeSettingRow = await this.getSettingRow(c3);
    if (!Number(intakeSettingRow.applyIntakeOpen)) {
      throw new biz_error_default(t3("applyEntryClosed"));
    }
    if (!verify_utils_default.isEmail(email4)) {
      throw new biz_error_default(t3("notEmail"));
    }
    const domainList = Array.isArray(c3.env.domain) ? c3.env.domain : JSON.parse(c3.env.domain);
    if (!domainList.includes(email_utils_default.getDomain(email4))) {
      throw new biz_error_default(t3("notEmailDomain"));
    }
    const settingRow = await this.getSettingRow(c3);
    const prefixFilters = String(settingRow.emailPrefixFilter || "").split(",").filter(Boolean);
    if (email_utils_default.getName(email4).length < settingRow.minEmailPrefix) {
      throw new biz_error_default(t3("applyMinPrefix"));
    }
    const bannedHit = prefixFilters.some((content) => email_utils_default.getName(email4).includes(content));
    if (bannedHit) {
      throw new biz_error_default(t3("banEmailPrefix"));
    }
    if (reasonText.length < REASON_MIN_LENGTH) {
      throw new biz_error_default(t3("reasonTooShort"));
    }
    const pendingRow = await orm(c3).select().from(apply_default).where(and(eq(apply_default.oauthUserId, oauthRow.oauthUserId), eq(apply_default.status, applyConst.status.PENDING))).get();
    if (pendingRow) {
      throw new biz_error_default(t3("applyExists"));
    }
    const accountRow = await account_service_default.selectByEmailIncludeDel(c3, email4);
    if (accountRow && accountRow.isDel === isDel.DELETE) {
      throw new biz_error_default(t3("isDelUser"));
    }
    if (accountRow) {
      throw new biz_error_default(t3("isRegAccount"));
    }
    let regCodeInfo = null;
    const regCode = String(params.code || "").trim();
    if (regCode) {
      regCodeInfo = await login_service_default.handleOpenRegKey(c3, settingConst.regKey.OPEN, regCode);
    }
    const applyRow = await orm(c3).insert(apply_default).values({
      oauthUserId: oauthRow.oauthUserId,
      platform: oauthRow.platform,
      username: oauthRow.username,
      name: oauthRow.name,
      avatar: oauthRow.avatar,
      trustLevel: oauthRow.trustLevel,
      email: email4,
      reason: reasonText,
      status: applyConst.status.PENDING,
      regCode,
      regRoleId: regCodeInfo ? regCodeInfo.type : 0
    }).returning().get();
    const threshold = settingRow.applyAutoTrustLevel == null ? 3 : Number(settingRow.applyAutoTrustLevel) || 0;
    const trustLevel = Number(oauthRow.trustLevel === null ? -1 : oauthRow.trustLevel);
    const useAi = Number(settingRow.applyAiReview) === 1;
    const fastLane = regCodeInfo || threshold > 0 && trustLevel >= threshold;
    if (fastLane && !useAi) {
      await this.approveWithFallback(c3, applyRow, "auto");
      return;
    }
    let verdict = null;
    if (useAi) {
      verdict = await ai_service_default.reviewApplication(c3, {
        fastLane,
        prefix: email_utils_default.getName(email4),
        platform: oauthRow.platform,
        username: oauthRow.username,
        trustLevel: oauthRow.trustLevel,
        reason: reasonText
      }, { key: settingRow.zhipuApiKey, model: settingRow.zhipuModel, baseUrl: settingRow.zhipuBaseUrl });
      if (verdict && !verdict.prefixOk) {
        await this.rejectByAi(c3, applyRow, verdict.reason);
        await this.notify(c3, applyRow, "ai-rejected");
        return;
      }
