      applyRow.remark = (e3.message || "unknown").slice(0, 200);
      await orm(c3).update(apply_default).set({
        status: voided ? applyConst.status.REJECTED : applyConst.status.PENDING,
        remark: applyRow.remark,
        updateTime: (0, import_dayjs6.default)().format("YYYY-MM-DD HH:mm:ss")
      }).where(eq(apply_default.applyId, applyRow.applyId)).run();
      if (!silent) {
        await this.notify(c3, applyRow, "fallback");
      }
