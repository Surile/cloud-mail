// src/dao/analysis-dao.js
init_modules_watch_stub();
var analysisDao = {
  async numberCount(c3) {
    const { results } = await c3.env.db.prepare(`
            SELECT
				COALESCE(e.receiveTotal, 0) AS receiveTotal,
				COALESCE(e.sendTotal, 0) AS sendTotal,
				COALESCE(e.delReceiveTotal, 0) AS delReceiveTotal,
				COALESCE(e.delSendTotal, 0) AS delSendTotal,
				COALESCE(e.normalReceiveTotal, 0) AS normalReceiveTotal,
				COALESCE(e.normalSendTotal, 0) AS normalSendTotal,
				COALESCE(u.userTotal, 0) AS userTotal,
				COALESCE(u.normalUserTotal, 0) AS normalUserTotal,
				COALESCE(u.delUserTotal, 0) AS delUserTotal,
				COALESCE(a.accountTotal, 0) AS accountTotal,
				COALESCE(a.normalAccountTotal, 0) AS normalAccountTotal,
				COALESCE(a.delAccountTotal, 0) AS delAccountTotal
            FROM
                (
                    SELECT
                        SUM(CASE WHEN type = 0 THEN 1 ELSE 0 END) AS receiveTotal,
                        SUM(CASE WHEN type = 1 THEN 1 ELSE 0 END) AS sendTotal,
                        SUM(CASE WHEN type = 0 AND is_del = 1 THEN 1 ELSE 0 END) AS delReceiveTotal,
                        SUM(CASE WHEN type = 1 AND is_del = 1 THEN 1 ELSE 0 END) AS delSendTotal,
                        SUM(CASE WHEN type = 0 AND is_del = 0 THEN 1 ELSE 0 END) AS normalReceiveTotal,
                        SUM(CASE WHEN type = 1 AND is_del = 0 THEN 1 ELSE 0 END) AS normalSendTotal
                    FROM
                        email
                ) e
            CROSS JOIN (
                SELECT
                    COUNT(*) AS userTotal,
                    SUM(CASE WHEN is_del = 1 THEN 1 ELSE 0 END) AS delUserTotal,
                    SUM(CASE WHEN is_del = 0 THEN 1 ELSE 0 END) AS normalUserTotal
                FROM
                    user
            ) u
            CROSS JOIN (
                SELECT
                    COUNT(*) AS accountTotal,
                    SUM(CASE WHEN is_del = 1 THEN 1 ELSE 0 END) AS delAccountTotal,
                    SUM(CASE WHEN is_del = 0 THEN 1 ELSE 0 END) AS normalAccountTotal
                FROM
                    account
            ) a
        `).all();
    return results[0];
  },
  async userDayCount(c3, diffHours) {
    const { tzMod, tzBack } = this.tzModifiers(diffHours);
    const { results } = await c3.env.db.prepare(`
            SELECT
                DATE(create_time, '${tzMod}') AS date,
                COUNT(*) AS total
            FROM
                user
            WHERE
                create_time >= datetime('now', '${tzMod}', 'start of day', '-15 days', '${tzBack}')
                AND create_time < datetime('now', '${tzMod}', 'start of day', '${tzBack}')
            GROUP BY
                DATE(create_time, '${tzMod}')
            ORDER BY
                date ASC
        `).all();
    return results;
  },
  async receiveDayCount(c3, diffHours) {
    const { tzMod, tzBack } = this.tzModifiers(diffHours);
    const { results } = await c3.env.db.prepare(`
            SELECT
                DATE(create_time, '${tzMod}') AS date,
                COUNT(*) AS total
            FROM
                email
            WHERE
                type = 0
                AND create_time >= datetime('now', '${tzMod}', 'start of day', '-15 days', '${tzBack}')
                AND create_time < datetime('now', '${tzMod}', 'start of day', '${tzBack}')
            GROUP BY
                DATE(create_time, '${tzMod}')
            ORDER BY
                date ASC
        `).all();
    return results;
  },
  async sendDayCount(c3, diffHours) {
    const { tzMod, tzBack } = this.tzModifiers(diffHours);
    const { results } = await c3.env.db.prepare(`
            SELECT
                DATE(create_time, '${tzMod}') AS date,
                COUNT(*) AS total
            FROM
                email
            WHERE
                type = 1
                AND create_time >= datetime('now', '${tzMod}', 'start of day', '-15 days', '${tzBack}')
                AND create_time < datetime('now', '${tzMod}', 'start of day', '${tzBack}')
            GROUP BY
                DATE(create_time, '${tzMod}')
            ORDER BY
                date ASC
        `).all();
    return results;
  },
  tzModifiers(diffHours) {
    const tzMod = diffHours >= 0 ? `+${diffHours} hours` : `${diffHours} hours`;
    const tzBack = -diffHours >= 0 ? `+${-diffHours} hours` : `${-diffHours} hours`;
    return { tzMod, tzBack };
  }
};
var analysis_dao_default = analysisDao;

// src/service/analysis-service.js
var import_dayjs9 = __toESM(require_dayjs_min());
var analysisService = {
  async echarts(c3, params) {
    if (!this.analysisCacheEnabled(c3)) {
      return await this.queryEcharts(c3, params);
    }
    const cacheKey = this.echartsCacheKey(params);
    const cache2 = await c3.env.kv.get(cacheKey, { type: "json" });
    if (cache2) {
      return cache2;
    }
    return await this.refreshEchartsCacheByKey(c3, cacheKey);
  },
  async refreshEchartsCacheByKey(c3, cacheKey) {
    const params = this.echartsParamsByCacheKey(cacheKey);
    const data = await this.queryEcharts(c3, params);
    await c3.env.kv.put(cacheKey, JSON.stringify(data));
    return data;
  },
  async refreshEchartsCache(c3) {
    if (!this.analysisCacheEnabled(c3)) {
      return;
    }
    const { keys: keys2 } = await c3.env.kv.list({ prefix: kv_const_default.ANALYSIS_ECHARTS });
    await Promise.all(keys2.map((key2) => this.refreshEchartsCacheByKey(c3, key2.name)));
  },
  async queryEcharts(c3, params) {
    const { timeZone } = params;
    let utcDate = toUtc().startOf("day");
    let localDate = utcDate.tz(timeZone);
    utcDate = (0, import_dayjs9.default)(utcDate.format("YYYY-MM-DD HH:mm:ss"));
    localDate = (0, import_dayjs9.default)(localDate.format("YYYY-MM-DD HH:mm:ss"));
    const diffHours = localDate.diff(utcDate, "hour", true);
    const [
      numberCount,
      nameRatio,
      userDayCountRaw,
      receiveDayCountRaw,
      sendDayCountRaw,
      daySendTotalRaw
    ] = await Promise.all([
      analysis_dao_default.numberCount(c3),
      orm(c3).select({ name: email_default.name, total: count() }).from(email_default).where(and(eq(email_default.type, emailConst.type.RECEIVE), isNotNull(email_default.name), ne(email_default.name, "noreply"), ne(email_default.name, ""))).groupBy(email_default.name).orderBy(desc(count())).limit(6),
      analysis_dao_default.userDayCount(c3, diffHours),
      analysis_dao_default.receiveDayCount(c3, diffHours),
      analysis_dao_default.sendDayCount(c3, diffHours),
      c3.env.kv.get(kv_const_default.SEND_DAY_COUNT + (0, import_dayjs9.default)().format("YYYY-MM-DD"))
    ]);
    const userDayCount = this.filterEmptyDay(userDayCountRaw, timeZone);
    const receiveDayCount = this.filterEmptyDay(receiveDayCountRaw, timeZone);
    const sendDayCount = this.filterEmptyDay(sendDayCountRaw, timeZone);
    const daySendTotal = daySendTotalRaw || 0;
    return {
      numberCount,
      userDayCount,
      receiveRatio: {
        nameRatio
      },
      emailDayCount: {
        receiveDayCount,
        sendDayCount
      },
      daySendTotal: Number(daySendTotal)
    };
  },
  filterEmptyDay(data, timeZone) {
    const today = toUtc().tz(timeZone).subtract(1, "day");
    const previousDays = Array.from({ length: 15 }, (_3, i2) => {
      return today.subtract(i2, "day").format("YYYY-MM-DD");
    }).reverse();
    return previousDays.map((day) => {
      const index = data.findIndex((item) => item.date === day);
      const total = index > -1 ? data[index].total : 0;
      return { date: day, total };
    });
  },
  echartsCacheKey(params = {}) {
    return kv_const_default.ANALYSIS_ECHARTS + encodeURIComponent(params.timeZone || "UTC");
  },
  echartsParamsByCacheKey(cacheKey) {
    return {
      timeZone: decodeURIComponent(cacheKey.replace(kv_const_default.ANALYSIS_ECHARTS, ""))
    };
  },
  analysisCacheEnabled(c3) {
    return c3.env.analysis_cache === true || c3.env.analysis_cache === "true";
  }
};
var analysis_service_default = analysisService;

