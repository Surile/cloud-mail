      );
    }
    if (name2) {
      conditions.push(sql`${email_default.name} COLLATE NOCASE LIKE ${name2 + "%"}`);
    }
    if (subject) {
      conditions.push(sql`${email_default.subject} COLLATE NOCASE LIKE ${subject + "%"}`);
    }
    if (withCursor && emailId) {
      conditions.push(timeSort ? gt(email_default.emailId, emailId) : lt(email_default.emailId, emailId));
    }
    return conditions;
  },
  async delete(c3, params, userId) {
    const { emailIds } = params;
    const emailIdList = emailIds.split(",").map(Number);
    const { syncDelete } = await setting_service_default.query(c3);
    if (syncDelete === settingConst.syncDelete.OPEN) {
      const owned = await orm(c3).select({ emailId: email_default.emailId }).from(email_default).where(and(eq(email_default.userId, userId), inArray(email_default.emailId, emailIdList))).all();
      const ownedIds = owned.map((row) => row.emailId);
      if (ownedIds.length) {
        await this.physicsDelete(c3, { emailIds: ownedIds.join(",") });
      }
      return;
    }
    await orm(c3).update(email_default).set({ isDel: isDel.DELETE }).where(
      and(
        eq(email_default.userId, userId),
        inArray(email_default.emailId, emailIdList)
      )
    ).run();
  },
  receive(c3, params, cidAttList, r2domain) {
    params.content = this.imgReplace(params.content, cidAttList, r2domain);
    return orm(c3).insert(email_default).values({ ...params }).returning().get();
  },
  //邮件发送
  async send(c3, params, userId) {
    let {
      accountId,
      //发送账号id
      name: name2,
      //发件人名字
      sendType,
      //发件类型
      emailId,
      //邮件id，如果是回复邮件会带
      receiveEmail,
      //收件人邮箱
      text: text2,
      //邮件纯文本
      content,
      //邮件内容
      subject,
      //邮件标题
      attachments = []
      //附件
    } = params;
    const { resendTokens, r2Domain, send, domainList } = await setting_service_default.query(c3);
    let { imageDataList, html } = await att_service_default.toImageUrlHtml(c3, content);
    if (send === settingConst.send.CLOSE) {
      throw new biz_error_default(t3("disabledSend"), 403);
    }
    const userRow = await user_service_default.selectById(c3, userId);
    const roleRow = await role_service_default.selectById(c3, userRow.type);
    const allInternal = receiveEmail.every((email4) => {
      const domain2 = "@" + email_utils_default.getDomain(email4);
      return domainList.includes(domain2);
    });
    if (c3.env.admin !== userRow.email) {
      if (roleRow.sendType === "ban") {
        throw new biz_error_default(t3("bannedSend"), 403);
      }
      if (roleRow.sendType === "internal" && !allInternal) {
        throw new biz_error_default(t3("onlyInternalSend"), 403);
      }
    }
    if (c3.env.admin !== userRow.email && roleRow.sendCount) {
      if (userRow.sendCount >= roleRow.sendCount) {
        if (roleRow.sendType === "day") throw new biz_error_default(t3("daySendLimit"), 403);
        if (roleRow.sendType === "count") throw new biz_error_default(t3("totalSendLimit"), 403);
      }
      if (userRow.sendCount + receiveEmail.length > roleRow.sendCount) {
        if (roleRow.sendType === "day") throw new biz_error_default(t3("daySendLack"), 403);
        if (roleRow.sendType === "count") throw new biz_error_default(t3("totalSendLack"), 403);
      }
    }
    const accountRow = await account_service_default.selectById(c3, accountId);
    if (!accountRow) {
      throw new biz_error_default(t3("senderAccountNotExist"));
    }
    if (accountRow.userId !== userId) {
      throw new biz_error_default(t3("sendEmailNotCurUser"));
    }
    if (c3.env.admin !== userRow.email) {
      if (!role_service_default.hasAvailDomainPerm(roleRow.availDomain, accountRow.email)) {
        throw new biz_error_default(t3("noDomainPermSend"), 403);
      }
    }
    const domain = email_utils_default.getDomain(accountRow.email);
    const resendToken = resendTokens[domain];
    const useCloudflareEmail = !!c3.env.email;
    if (!useCloudflareEmail && !resendToken && !allInternal) {
      throw new biz_error_default(t3("noSendProvider"));
    }
    if (!name2) {
      name2 = email_utils_default.getName(accountRow.email);
    }
    let emailRow = {
      messageId: null
    };
    if (sendType === "reply") {
      emailRow = await this.selectById(c3, emailId);
      if (!emailRow) {
        throw new biz_error_default(t3("notExistEmailReply"));
      }
    }
    let sendResult = {};
    if (!allInternal) {
      if (useCloudflareEmail) {
        sendResult = await this.sendByCloudflareEmail(c3, {
          name: name2,
          accountEmail: accountRow.email,
          receiveEmail,
          subject,
          text: text2,
          html,
          attachments: [...imageDataList, ...attachments],
          sendType,
          messageId: emailRow.messageId
        });
      } else {
        sendResult = await this.sendByResend(resendToken, {
          name: name2,
          accountEmail: accountRow.email,
          receiveEmail,
          subject,
          text: text2,
          html,
          attachments: [...imageDataList, ...attachments],
          sendType,
          messageId: emailRow.messageId
        });
      }
    }
    const { data, error } = sendResult;
    if (error) {
      throw new biz_error_default(error.message);
    }
    imageDataList = imageDataList.map((item) => ({ ...item, contentId: `<${item.contentId}>` }));
    html = this.imgReplace(html, imageDataList, r2Domain);
    const emailData = {};
    emailData.sendEmail = accountRow.email;
    emailData.name = name2;
    emailData.subject = subject;
    emailData.content = html;
    emailData.text = text2;
    emailData.accountId = accountId;
    emailData.status = useCloudflareEmail ? emailConst.status.DELIVERED : emailConst.status.SENT;
    emailData.type = emailConst.type.SEND;
    emailData.userId = userId;
    emailData.resendEmailId = data?.id;
    const recipient = [];
    receiveEmail.forEach((item) => {
      recipient.push({ address: item, name: "" });
    });
    emailData.recipient = JSON.stringify(recipient);
    if (sendType === "reply") {
      emailData.inReplyTo = emailRow.messageId;
      emailData.relation = emailRow.messageId;
    }
    if (roleRow.sendCount && roleRow.sendType !== "internal") {
      await user_service_default.incrUserSendCount(c3, receiveEmail.length, userId);
    }
    const emailResult = await orm(c3).insert(email_default).values(emailData).returning().get();
    if (imageDataList.length > 0) {
      if (imageDataList.length > 10) {
        throw new biz_error_default(t3("imageAttLimit"));
      }
      await att_service_default.saveArticleAtt(c3, imageDataList, userId, accountId, emailResult.emailId);
    }
    if (attachments?.length > 0) {
      if (attachments.length > 10) {
        throw new biz_error_default(t3("attLimit"));
      }
      await att_service_default.saveSendAtt(c3, attachments, userId, accountId, emailResult.emailId);
    }
    const attList = await att_service_default.selectByEmailIds(c3, [emailResult.emailId]);
    emailResult.attList = attList;
    if (allInternal) {
      await this.HandleOnSiteEmail(c3, receiveEmail, emailResult, attList);
    }
    const dateStr = (0, import_dayjs3.default)().format("YYYY-MM-DD");
    let daySendTotal = await c3.env.kv.get(kv_const_default.SEND_DAY_COUNT + dateStr);
    if (!daySendTotal) {
      await c3.env.kv.put(kv_const_default.SEND_DAY_COUNT + dateStr, JSON.stringify(receiveEmail.length), { expirationTtl: 60 * 60 * 24 });
    } else {
      daySendTotal = Number(daySendTotal) + receiveEmail.length;
      await c3.env.kv.put(kv_const_default.SEND_DAY_COUNT + dateStr, JSON.stringify(daySendTotal), { expirationTtl: 60 * 60 * 24 });
    }
    return [emailResult];
  },
  async sendByCloudflareEmail(c3, params) {
    const sendForm = {
      from: { email: params.accountEmail, name: params.name },
      to: [...params.receiveEmail],
      subject: params.subject
    };
    if (params.text) {
      sendForm.text = params.text;
    }
    if (params.html) {
      sendForm.html = params.html;
    }
    const attachments = await this.toCloudflareAttachments(params.attachments);
    if (attachments.length > 0) {
      sendForm.attachments = attachments;
    }
    if (params.sendType === "reply" && params.messageId) {
      sendForm.headers = {
        "in-reply-to": params.messageId,
        "references": params.messageId
      };
    }
    const result2 = await c3.env.email.send(sendForm);
    return {
      data: {
        id: result2.messageId
      }
    };
  },
  async sendByResend(resendToken, params) {
    const resend = new Resend(resendToken);
    const sendForm = {
      from: `${params.name} <${params.accountEmail}>`,
      to: [...params.receiveEmail],
      subject: params.subject,
      text: params.text,
      html: params.html,
      attachments: await this.toResendAttachments(params.attachments)
    };
    if (params.sendType === "reply") {
      sendForm.headers = {
        "in-reply-to": params.messageId,
        "references": params.messageId
      };
    }
    return await resend.emails.send(sendForm);
  },
  async toCloudflareAttachments(attachments) {
    const arrayBufferAttachments = await this.toArrayBufferAttachments(attachments);
    return arrayBufferAttachments.map((attachment) => {
      const item = {
        content: attachment.content,
        filename: attachment.filename,
        type: attachment.mimeType || attachment.contentType || attachment.type || "application/octet-stream",
        disposition: attachment.contentId ? "inline" : "attachment"
      };
      if (attachment.contentId) {
        item.contentId = attachment.contentId.replace(/^<|>$/g, "");
      }
      return item;
    });
  },
  async toResendAttachments(attachments = []) {
    const result2 = [];
    for (const attachment of attachments) {
      const content = await this.toAttachmentBase64(attachment);
      if (!content) {
        continue;
      }
      result2.push({
        ...attachment,
        content,
        contentType: attachment.contentType || attachment.mimeType || attachment.type || "application/octet-stream"
      });
    }
    return result2;
  },
  async toArrayBufferAttachments(attachments = []) {
    const result2 = [];
    for (const attachment of attachments) {
      const content = await this.toAttachmentArrayBuffer(attachment);
      if (!content) {
        continue;
      }
      result2.push({ ...attachment, content });
    }
    return result2;
  },
  async toAttachmentBase64(attachment) {
    let content = attachment.content;
    if (!content) {
      return null;
    }
    if (typeof content === "string") {
      if (content.startsWith("data:")) {
        content = content.split(",")[1] || content;
      }
      return content.replace(/\s+/g, "");
    }
    const arrayBuffer = await this.toAttachmentArrayBuffer(attachment);
    if (!arrayBuffer) {
      return null;
    }
    const bytes = new Uint8Array(arrayBuffer);
    let binary = "";
    for (let i2 = 0; i2 < bytes.length; i2 += 32768) {
      binary += String.fromCharCode(...bytes.subarray(i2, i2 + 32768));
    }
    return btoa(binary);
  },
  async toAttachmentArrayBuffer(attachment) {
    let content = attachment.content;
    if (!content) {
      return null;
    }
    if (content instanceof ArrayBuffer) {
      return content;
    }
    if (content instanceof Uint8Array) {
      return content.buffer.slice(content.byteOffset, content.byteOffset + content.byteLength);
    }
    if (typeof content === "string") {
      if (content.startsWith("data:")) {
        content = content.split(",")[1] || content;
      }
      return file_utils_default.base64ToUint8Array(content.replace(/\s+/g, "")).buffer;
    }
    return content;
  },
  //处理站内邮件发送
  async HandleOnSiteEmail(c3, receiveEmail, sendEmailData, attList) {
    const { noRecipient } = await setting_service_default.query(c3);
    let accountList = await orm(c3).select().from(account_default).where(inArray(account_default.email, receiveEmail)).all();
    const plusEmails = receiveEmail.filter(
      (e3) => e3.includes("+") && !accountList.some((a2) => a2.email === e3)
    );
    const baseAccounts = [];
    if (plusEmails.length > 0) {
      const baseEmails = [...new Set(
        plusEmails.map((e3) => email_utils_default.getBaseEmail(e3)).filter(Boolean)
      )];
      const existing = new Set(accountList.map((a2) => a2.email));
      const needed = baseEmails.filter((e3) => !existing.has(e3));
      if (needed.length > 0) {
        const rows = await orm(c3).select().from(account_default).where(inArray(account_default.email, needed)).all();
        baseAccounts.push(...rows);
      }
    }
    const allAccounts = [...accountList, ...baseAccounts];
    const userIds = allAccounts.map((accountRow) => accountRow.userId);
    let roleList = await role_service_default.selectByUserIds(c3, userIds);
    const emailDataList = [];
    for (const email4 of receiveEmail) {
      const emailValues = { ...sendEmailData };
      emailValues.status = emailConst.status.RECEIVE;
      emailValues.type = emailConst.type.RECEIVE;
      emailValues.toEmail = email4;
      emailValues.toName = email_utils_default.getName(email4);
      emailValues.emailId = null;
      let accountRow = allAccounts.find((accountRow2) => accountRow2.email === email4);
      if (!accountRow && email4.includes("+")) {
        const baseEmail = email_utils_default.getBaseEmail(email4);
        accountRow = allAccounts.find((accountRow2) => accountRow2.email === baseEmail);
      }
      if (accountRow) {
        emailValues.userId = accountRow.userId;
        emailValues.accountId = accountRow.accountId;
        emailValues.type = emailConst.type.RECEIVE;
        emailValues.status = emailConst.status.RECEIVE;
        const roleRow = roleList.find((roleRow2) => roleRow2.userId === accountRow.userId);
        let { banEmail, availDomain } = roleRow;
        if (email4 !== c3.env.admin) {
          if (!role_service_default.hasAvailDomainPerm(availDomain, email4)) {
            emailValues.status = emailConst.status.BOUNCED;
            emailValues.message = `The recipient <${email4}> is not authorized to use this domain.`;
          } else if (role_service_default.isBanEmail(banEmail, sendEmailData.sendEmail)) {
            emailValues.status = emailConst.status.BOUNCED;
            emailValues.message = `The recipient <${email4}> is disabled from receiving emails.`;
          }
        }
        emailDataList.push(emailValues);
      } else {
        emailValues.userId = 0;
        emailValues.accountId = 0;
        emailValues.type = emailConst.type.RECEIVE;
        emailValues.status = emailConst.status.NOONE;
        if (noRecipient === settingConst.noRecipient.CLOSE) {
          emailValues.status = emailConst.status.BOUNCED;
          emailValues.message = `Recipient not found: <${email4}>`;
        }
        emailDataList.push(emailValues);
      }
    }
    const receiveEmailList = emailDataList.filter((emailRow) => emailRow.status === emailConst.status.RECEIVE || emailRow.status === emailConst.status.NOONE);
    for (const emailData of receiveEmailList) {
      const emailRow = await orm(c3).insert(email_default).values(emailData).returning().get();
      for (const attRow of attList) {
        const attValues = { ...attRow };
        attValues.emailId = emailRow.emailId;
        attValues.accountId = emailRow.accountId;
        attValues.userId = emailRow.userId;
        attValues.attId = null;
        await orm(c3).insert(att).values(attValues).run();
      }
    }
    const bouncedEmail = emailDataList.find((emailRow) => emailRow.status === emailConst.status.BOUNCED);
    let status = emailConst.status.DELIVERED;
    let message = "";
    if (bouncedEmail) {
      const messageJson = { message: bouncedEmail.message };
      message = JSON.stringify(messageJson);
      status = emailConst.status.BOUNCED;
    }
    await orm(c3).update(email_default).set({ status, message }).where(eq(email_default.emailId, sendEmailData.emailId)).run();
  },
  imgReplace(content, cidAttList, r2domain) {
    if (!content) {
      return "";
    }
    const { document } = parseHTML(content);
    const images = Array.from(document.querySelectorAll("img"));
    const useAtts = [];
    for (const img of images) {
      const src = img.getAttribute("src");
      if (src && src.startsWith("cid:") && cidAttList) {
        const cid = src.replace(/^cid:/, "");
        const attCidIndex = cidAttList.findIndex((cidAtt) => cidAtt.contentId.replace(/^<|>$/g, "") === cid);
        if (attCidIndex > -1) {
          const cidAtt = cidAttList[attCidIndex];
          img.setAttribute("src", "{{domain}}" + cidAtt.key);
          useAtts.push(cidAtt);
        }
      }
      r2domain = domain_uitls_default.toOssDomain(r2domain);
      if (src && src.startsWith(r2domain + "/")) {
        img.setAttribute("src", src.replace(r2domain + "/", "{{domain}}"));
      }
    }
    useAtts.forEach((att2) => {
      att2.type = attConst.type.EMBED;
    });
    return document.toString();
  },
  selectById(c3, emailId) {
    return orm(c3).select().from(email_default).where(
      and(
        eq(email_default.emailId, emailId),
        eq(email_default.isDel, isDel.NORMAL)
      )
    ).get();
  },
  async latest(c3, params, userId) {
    let { emailId, accountId, allReceive } = params;
    allReceive = Number(allReceive);
    if (isNaN(allReceive)) {
      let accountRow = await account_service_default.selectById(c3, accountId);
      allReceive = accountRow.allReceive;
    }
    let list = await orm(c3).select({ ...emailBriefColumns }).from(email_default).innerJoin(
      account_default,
      eq(account_default.accountId, email_default.accountId)
    ).where(
      and(
        gt(email_default.emailId, emailId),
        eq(email_default.userId, userId),
        eq(email_default.isDel, isDel.NORMAL),
        eq(account_default.isDel, isDel.NORMAL),
        allReceive ? void 0 : eq(email_default.accountId, accountId),
        eq(email_default.type, emailConst.type.RECEIVE)
      )
    ).orderBy(desc(email_default.emailId)).limit(20);
    return this.applyListText(list);
  },
