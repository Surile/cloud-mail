    if (applyRow.regCode) {
      const codeRow = await reg_key_service_default.selectByCode(c3, applyRow.regCode);
      if (codeRow) {
        regKeyId = codeRow.regKeyId;
        await reg_key_service_default.reduceCount(c3, applyRow.regCode, 1);
      }
    }
    await user_service_default.add(c3, {
      email: applyRow.email,
      password: crypto_utils_default.genRandomPwd(),
      type: roleId,
      regKeyId
    });
    const userRow = await user_service_default.selectByEmail(c3, applyRow.email);
    await orm(c3).update(oauth).set({ userId: userRow.userId }).where(eq(oauth.oauthId, oauthRow.oauthId)).run();
    await orm(c3).update(apply_default).set({
      status: applyConst.status.APPROVED,
      adminId,
      updateTime: (0, import_dayjs6.default)().format("YYYY-MM-DD HH:mm:ss")
    }).where(eq(apply_default.applyId, applyRow.applyId)).run();
  },
  async reject(c3, params, adminId) {
    const applyRow = await orm(c3).select().from(apply_default).where(eq(apply_default.applyId, Number(params.applyId))).get();
    if (!applyRow) {
      throw new biz_error_default(t3("applyNotFound"));
    }
    if (applyRow.status !== applyConst.status.PENDING) {
      throw new biz_error_default(t3("applyProcessed"));
    }
    const remark = String(params.remark || "").trim().slice(0, 200);
    await orm(c3).update(apply_default).set({
      status: applyConst.status.REJECTED,
      remark,
      adminId,
      updateTime: (0, import_dayjs6.default)().format("YYYY-MM-DD HH:mm:ss")
    }).where(eq(apply_default.applyId, applyRow.applyId)).run();
  },
  // 批量人工操作：逐条走完整的开通/驳回链路，单条失败不影响其他，返回失败明细
  async batchApprove(c3, params, adminId) {
    return await this.runBatch(c3, params.applyIds, adminId, "approve", params.remark);
  },
  async batchReject(c3, params, adminId) {
    return await this.runBatch(c3, params.applyIds, adminId, "reject", params.remark);
  },
  async runBatch(c3, applyIds, adminId, action, remark) {
    const ids = (Array.isArray(applyIds) ? applyIds : []).map(Number).filter(Boolean).slice(0, 100);
    const okIds = [];
    const failed = [];
    for (const applyId of ids) {
      try {
        const applyRow = await orm(c3).select().from(apply_default).where(eq(apply_default.applyId, applyId)).get();
        if (!applyRow) {
          throw new biz_error_default(t3("applyNotFound"));
        }
        if (applyRow.status !== applyConst.status.PENDING) {
          throw new biz_error_default(t3("applyProcessed"));
        }
        if (action === "approve") {
          await this.doApprove(c3, applyRow, adminId);
        } else {
          const clean = String(remark || "").trim().slice(0, 200);
          await orm(c3).update(apply_default).set({
            status: applyConst.status.REJECTED,
            remark: clean,
            adminId,
            updateTime: (0, import_dayjs6.default)().format("YYYY-MM-DD HH:mm:ss")
          }).where(eq(apply_default.applyId, applyRow.applyId)).run();
        }
        okIds.push(applyId);
      } catch (e3) {
        failed.push({ applyId, message: e3.message });
      }
    }
    return { ok: okIds.length, okIds, failed };
  },
  async notify(c3, applyRow, mode) {
    if (!applyRow) {
      return;
    }
    try {
      const settingRow = await this.getSettingRow(c3);
      const token2 = settingRow.tgBotToken;
      const rawChatId = settingRow.tgChatId;
      if (!token2 || !rawChatId || Number(settingRow.tgBotStatus) === settingConst.tgBotStatus.CLOSE) {
        return;
      }
      const trustText = applyRow.trustLevel === null ? "unknown" : ["TL", applyRow.trustLevel].join("");
      const who = [applyRow.username, applyRow.platform, trustText].filter(Boolean).join(" ");
      const headMap = {
        auto: "\u90AE\u7BB1\u7533\u8BF7\u5DF2\u81EA\u52A8\u901A\u8FC7",
        fallback: "\u90AE\u7BB1\u7533\u8BF7\u81EA\u52A8\u901A\u8FC7\u5931\u8D25\uFF0C\u8F6C\u4EBA\u5DE5\u5BA1\u6838",
        pending: "\u6536\u5230\u65B0\u7684\u90AE\u7BB1\u7533\u8BF7\uFF08\u5F85\u4EBA\u5DE5\u5BA1\u6838\uFF09",
        approved: "\u90AE\u7BB1\u7533\u8BF7\u5DF2\u4EBA\u5DE5\u901A\u8FC7",
        "ai-approved": "AI \u5BA1\u6838\u901A\u8FC7\uFF0C\u5DF2\u81EA\u52A8\u5F00\u901A",
        "ai-rejected": "AI \u5BA1\u6838\u9A73\u56DE\uFF08\u53EF\u5728\u540E\u53F0\u590D\u6838\uFF09"
      };
      const reasonPart = mode === "fallback" || mode === "ai-rejected" ? ["\u539F\u56E0\uFF1A", applyRow.remark].join("") : "";
      const lines = [
        headMap[mode] || "\u90AE\u7BB1\u7533\u8BF7\u72B6\u6001\u66F4\u65B0",
        ["\u7533\u8BF7\u4EBA\uFF1A", who].join(""),
        ["\u671F\u671B\u5730\u5740\uFF1A", applyRow.email].join(""),
        reasonPart
      ];
      const apiBase = ["https://api.telegram.org/bot", token2, "/sendMessage"].join("");
      const chatIds = String(rawChatId).split(",").map((item) => item.trim()).filter(Boolean);
      for (const chatId of chatIds) {
        await fetch(apiBase, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            chat_id: chatId,
            text: lines.filter(Boolean).join("\n")
          })
        });
      }
    } catch (e3) {
      console.error("Telegram notify failed:", e3.message);
    }
  }
};
var apply_service_default = applyService;

// src/service/oauth-service.js
var oauthService = {
  async bindUser(c3, params) {
    const { email: email4, oauthUserId, code } = params;
    const oauthRow = await this.getById(c3, oauthUserId);
    let userRow = await user_service_default.selectByIdIncludeDel(c3, oauthRow.userId);
    if (userRow) {
      throw new biz_error_default("\u7528\u6237\u5DF2\u7ED1\u5B9A\u6709\u90AE\u7BB1");
    }
    await login_service_default.register(c3, { email: email4, password: crypto_utils_default.genRandomPwd(), code }, true);
    userRow = await user_service_default.selectByEmail(c3, email4);
    orm(c3).update(oauth).set({ userId: userRow.userId }).where(eq(oauth.oauthUserId, oauthUserId)).run();
    const jwtToken = await login_service_default.login(c3, { email: email4, password: null }, true);
    return { userInfo: oauthRow, token: jwtToken };
  },
  async linuxDoLogin(c3, params) {
    const { code, redirectUri } = params;
    const setting2 = await setting_service_default.query(c3);
    this.assertEnabled(setting2, "linuxdoSwitch");
    const reqParams = new URLSearchParams();
    reqParams.append("client_id", setting2.linuxdoClientId);
    reqParams.append("client_secret", setting2.linuxdoClientSecret);
    reqParams.append("code", code);
    reqParams.append("redirect_uri", redirectUri);
    reqParams.append("grant_type", "authorization_code");
    const tokenRes = await fetch("https://connect.linux.do/oauth2/token", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: reqParams.toString()
    });
    if (!tokenRes.ok) {
      throw new biz_error_default(tokenRes.statusText);
    }
    const token2 = await tokenRes.json();
    const userRes = await fetch("https://connect.linux.do/api/user", {
      headers: {
        Authorization: "Bearer " + token2.access_token
      }
    });
    if (!userRes.ok) {
      throw new biz_error_default(userRes.statusText);
    }
    const userInfo = await userRes.json();
    userInfo.oauthUserId = String(userInfo.id);
    userInfo.active = userInfo.active ? 0 : 1;
    userInfo.silenced = userInfo.silenced ? 0 : 1;
    userInfo.trustLevel = userInfo.trust_level;
    userInfo.avatar = userInfo.avatar_url;
    userInfo.platform = "linuxdo";
    return await this.saveAndLogin(c3, userInfo);
  },
  async githubLogin(c3, params) {
    const { code, redirectUri } = params;
    const setting2 = await setting_service_default.query(c3);
    this.assertEnabled(setting2, "githubSwitch");
    const tokenRes = await fetch("https://github.com/login/oauth/access_token", {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
        "Accept": "application/json"
      },
      body: JSON.stringify({
        client_id: setting2.githubClientId,
        client_secret: setting2.githubClientSecret,
        code,
        redirect_uri: redirectUri
      })
    });
    if (!tokenRes.ok) {
      throw new biz_error_default(tokenRes.statusText);
    }
    const token2 = await tokenRes.json();
    if (token2.error) {
      throw new biz_error_default(token2.error_description || token2.error);
    }
    const userRes = await fetch("https://api.github.com/user", {
      headers: {
        Authorization: "Bearer " + token2.access_token,
        "User-Agent": "cloud-mail"
      }
    });
    if (!userRes.ok) {
      throw new biz_error_default(userRes.statusText);
    }
    const userInfo = await userRes.json();
    userInfo.oauthUserId = String(userInfo.id);
    userInfo.username = userInfo.login;
    userInfo.avatar = userInfo.avatar_url;
    userInfo.platform = "github";
    return await this.saveAndLogin(c3, userInfo);
  },
  async googleLogin(c3, params) {
    const { code, redirectUri } = params;
    const setting2 = await setting_service_default.query(c3);
    this.assertEnabled(setting2, "googleSwitch");
    const reqParams = new URLSearchParams();
    reqParams.append("client_id", setting2.googleClientId);
    reqParams.append("client_secret", setting2.googleClientSecret);
    reqParams.append("code", code);
    reqParams.append("redirect_uri", redirectUri);
    reqParams.append("grant_type", "authorization_code");
    const tokenRes = await fetch("https://oauth2.googleapis.com/token", {
      method: "POST",
      headers: { "Content-Type": "application/x-www-form-urlencoded" },
      body: reqParams.toString()
    });
    if (!tokenRes.ok) {
      throw new biz_error_default(tokenRes.statusText);
    }
    const token2 = await tokenRes.json();
    const userRes = await fetch("https://openidconnect.googleapis.com/v1/userinfo", {
      headers: {
        Authorization: "Bearer " + token2.access_token
      }
    });
    if (!userRes.ok) {
      throw new biz_error_default(userRes.statusText);
    }
    const userInfo = await userRes.json();
    userInfo.oauthUserId = String(userInfo.sub);
    userInfo.username = userInfo.email;
    userInfo.name = userInfo.name;
    userInfo.avatar = userInfo.picture;
    userInfo.platform = "google";
    return await this.saveAndLogin(c3, userInfo);
  },
  async saveAndLogin(c3, userInfo) {
    const oauthRow = await this.saveUser(c3, userInfo);
    const userRow = await user_service_default.selectByIdIncludeDel(c3, oauthRow.userId);
    if (!userRow) {
      const applyJwt = await apply_service_default.generateApplyToken(c3, oauthRow.oauthUserId);
      return { userInfo: oauthRow, token: null, applyJwt };
    }
    const JwtToken = await login_service_default.login(c3, { email: userRow.email, password: null }, true);
    return { userInfo: oauthRow, token: JwtToken };
  },
  async saveUser(c3, userInfo) {
    const userInfoRow = await this.getById(c3, userInfo.oauthUserId);
    if (!userInfoRow) {
      return await orm(c3).insert(oauth).values(userInfo).returning().get();
    } else {
      return await orm(c3).update(oauth).set(userInfo).where(eq(oauth.oauthUserId, userInfo.oauthUserId)).returning().get();
    }
  },
  assertEnabled(setting2, switchKey) {
    if (setting2[switchKey] !== 0) {
      throw new biz_error_default(t3("oauthDisabled"));
    }
  },
  async getById(c3, oauthUserId) {
    return await orm(c3).select().from(oauth).where(eq(oauth.oauthUserId, oauthUserId)).get();
  },
  async deleteByUserId(c3, userId) {
    await this.deleteByUserIds(c3, [userId]);
  },
  async deleteByUserIds(c3, userIds) {
    await orm(c3).delete(oauth).where(inArray(oauth.userId, userIds)).run();
  },
  //定时任务凌晨清除未绑定邮箱的oauth用户；保留仍存在待审申请的身份，避免申请人等待审核期间被误删
  async clearNoBindOathUser(c3) {
    const pendingSubQuery = orm(c3).select({ oid: apply_default.oauthUserId }).from(apply_default).where(eq(apply_default.status, applyConst.status.PENDING));
    await orm(c3).delete(oauth).where(and(
      eq(oauth.userId, 0),
      notInArray(oauth.oauthUserId, pendingSubQuery)
    )).run();
  }
};
var oauth_service_default = oauthService;

// src/service/user-service.js
var userService = {
  async loginUserInfo(c3, userId) {
    const userRow = await userService.selectById(c3, userId);
    if (!userRow) {
      throw new biz_error_default(t3("authExpired"), 401);
    }
    const [account2, roleRow, permKeys] = await Promise.all([
      account_service_default.selectByEmailIncludeDel(c3, userRow.email),
      role_service_default.selectById(c3, userRow.type),
      userRow.email === c3.env.admin ? Promise.resolve(["*"]) : perm_service_default.userPermKeys(c3, userId)
    ]);
    const user2 = {};
    user2.userId = userRow.userId;
    user2.sendCount = userRow.sendCount;
    user2.email = userRow.email;
    user2.account = account2;
    user2.name = account2.name;
    user2.permKeys = permKeys;
    user2.role = roleRow;
    user2.type = userRow.type;
    if (c3.env.admin === userRow.email) {
      user2.role = constant_default.ADMIN_ROLE;
      user2.type = 0;
    }
    return user2;
  },
  async resetPassword(c3, params, userId) {
    const { password } = params;
    if (password.length < 6) {
      throw new biz_error_default(t3("pwdMinLength"));
    }
    const { salt, hash } = await crypto_utils_default.hashPassword(password);
    await orm(c3).update(user_default).set({ password: hash, salt }).where(eq(user_default.userId, userId)).run();
  },
  selectByEmail(c3, email4) {
    return orm(c3).select().from(user_default).where(
      and(
        eq(user_default.email, email4),
        eq(user_default.isDel, isDel.NORMAL)
      )
    ).get();
  },
  async insert(c3, params) {
    const { userId } = await orm(c3).insert(user_default).values({ ...params }).returning().get();
    return userId;
  },
  selectByEmailIncludeDel(c3, email4) {
    return orm(c3).select().from(user_default).where(sql`${user_default.email} COLLATE NOCASE = ${email4}`).get();
  },
  selectByIdIncludeDel(c3, userId) {
    return orm(c3).select().from(user_default).where(eq(user_default.userId, userId)).get();
  },
  selectById(c3, userId) {
    return orm(c3).select().from(user_default).where(
      and(
        eq(user_default.userId, userId),
        eq(user_default.isDel, isDel.NORMAL)
      )
    ).get();
  },
  async delete(c3, userId) {
    const { syncDelete } = await setting_service_default.query(c3);
    if (syncDelete === settingConst.syncDelete.OPEN) {
      await this.physicsDelete(c3, { userIds: String(userId) });
      await c3.env.kv.delete(kv_const_default.AUTH_INFO + userId);
      return;
    }
    await oauth_service_default.deleteByUserIds(c3, [Number(userId)]);
    await orm(c3).update(user_default).set({ isDel: isDel.DELETE }).where(eq(user_default.userId, userId)).run();
    await c3.env.kv.delete(kv_const_default.AUTH_INFO + userId);
  },
  async physicsDelete(c3, params) {
    let { userIds } = params;
    userIds = userIds.split(",").map(Number);
    await star_service_default.removeByUserIds(c3, userIds);
    await account_service_default.physicsDeleteByUserIds(c3, userIds);
    await oauth_service_default.deleteByUserIds(c3, userIds);
    await orm(c3).delete(user_default).where(inArray(user_default.userId, userIds)).run();
  },
  async list(c3, params) {
    let { num, size, email: email4, timeSort, status } = params;
    size = Number(size);
    num = Number(num);
    timeSort = Number(timeSort);
    params.isDel = Number(params.isDel);
    if (size > 50) {
      size = 50;
    }
    num = (num - 1) * size;
    const conditions = [];
    if (status > -1) {
      conditions.push(eq(user_default.status, status));
      conditions.push(eq(user_default.isDel, isDel.NORMAL));
    }
    if (email4) {
      conditions.push(sql`${user_default.email} COLLATE NOCASE LIKE ${email4 + "%"}`);
    }
    if (params.isDel) {
      conditions.push(eq(user_default.isDel, params.isDel));
    }
    const query2 = orm(c3).select({
      ...user_default,
      username: oauth.username,
      trustLevel: oauth.trustLevel,
      avatar: oauth.avatar,
      name: oauth.name,
      platform: oauth.platform
    }).from(user_default).leftJoin(oauth, eq(oauth.userId, user_default.userId)).where(and(...conditions));
    if (timeSort) {
      query2.orderBy(asc(user_default.userId));
    } else {
      query2.orderBy(desc(user_default.userId));
    }
    const list = await query2.limit(size).offset(num);
    const { total } = await orm(c3).select({ total: count() }).from(user_default).where(and(...conditions)).get();
    const userIds = list.map((user2) => user2.userId);
    const types = [...new Set(list.map((user2) => user2.type))];
    const [emailCounts, delEmailCounts, sendCounts, delSendCounts, accountCounts, delAccountCounts, roleList] = await Promise.all([
      email_service_default.selectUserEmailCountList(c3, userIds, emailConst.type.RECEIVE),
      email_service_default.selectUserEmailCountList(c3, userIds, emailConst.type.RECEIVE, isDel.DELETE),
      email_service_default.selectUserEmailCountList(c3, userIds, emailConst.type.SEND),
      email_service_default.selectUserEmailCountList(c3, userIds, emailConst.type.SEND, isDel.DELETE),
      account_service_default.selectUserAccountCountList(c3, userIds),
      account_service_default.selectUserAccountCountList(c3, userIds, isDel.DELETE),
      role_service_default.selectByIdsHasPermKey(c3, types, "email:send")
    ]);
    const receiveMap = Object.fromEntries(emailCounts.map((item) => [item.userId, item.count]));
    const sendMap = Object.fromEntries(sendCounts.map((item) => [item.userId, item.count]));
    const accountMap = Object.fromEntries(accountCounts.map((item) => [item.userId, item.count]));
    const delReceiveMap = Object.fromEntries(delEmailCounts.map((item) => [item.userId, item.count]));
    const delSendMap = Object.fromEntries(delSendCounts.map((item) => [item.userId, item.count]));
    const delAccountMap = Object.fromEntries(delAccountCounts.map((item) => [item.userId, item.count]));
    for (const user2 of list) {
      const userId = user2.userId;
      user2.receiveEmailCount = receiveMap[userId] || 0;
      user2.sendEmailCount = sendMap[userId] || 0;
      user2.accountCount = accountMap[userId] || 0;
      user2.delReceiveEmailCount = delReceiveMap[userId] || 0;
      user2.delSendEmailCount = delSendMap[userId] || 0;
      user2.delAccountCount = delAccountMap[userId] || 0;
      const roleIndex = roleList.findIndex((roleRow) => user2.type === roleRow.roleId);
      let sendAction = {};
      if (roleIndex > -1) {
        sendAction.sendType = roleList[roleIndex].sendType;
        sendAction.sendCount = roleList[roleIndex].sendCount;
        sendAction.hasPerm = true;
      } else {
        sendAction.hasPerm = false;
      }
      if (user2.email === c3.env.admin) {
        sendAction.sendType = constant_default.ADMIN_ROLE.sendType;
        sendAction.sendCount = constant_default.ADMIN_ROLE.sendCount;
        sendAction.hasPerm = true;
        user2.type = 0;
      }
      user2.sendAction = sendAction;
    }
    return { list, total };
  },
  async updateUserInfo(c3, userId, recordCreateIp = false) {
    const activeIp = req_utils_default.getIp(c3);
    const { os: os2, browser, device } = req_utils_default.getUserAgent(c3);
    const params = {
      os: os2,
      browser,
      device,
      activeIp,
      activeTime: (0, import_dayjs7.default)().format("YYYY-MM-DD HH:mm:ss")
    };
    if (recordCreateIp) {
      params.createIp = activeIp;
    }
    await orm(c3).update(user_default).set(params).where(eq(user_default.userId, userId)).run();
  },
  async setPwd(c3, params) {
    const { password, userId } = params;
    await this.resetPassword(c3, { password }, userId);
    await c3.env.kv.delete(kv_const_default.AUTH_INFO + userId);
  },
  async setStatus(c3, params) {
    const { status, userId } = params;
    await orm(c3).update(user_default).set({ status }).where(eq(user_default.userId, userId)).run();
    if (status === userConst.status.BAN) {
      await c3.env.kv.delete(kv_const_default.AUTH_INFO + userId);
    }
  },
  async setType(c3, params) {
    const { type, userId } = params;
    const roleRow = await role_service_default.selectById(c3, type);
    if (!roleRow) {
      throw new biz_error_default(t3("roleNotExist"));
    }
    await orm(c3).update(user_default).set({ type }).where(eq(user_default.userId, userId)).run();
  },
  async incrUserSendCount(c3, quantity, userId) {
    await orm(c3).update(user_default).set({
      sendCount: sql`${user_default.sendCount}
	  +
	  ${quantity}`
    }).where(eq(user_default.userId, userId)).run();
  },
  async updateAllUserType(c3, type, curType) {
    await orm(c3).update(user_default).set({ type }).where(eq(user_default.type, curType)).run();
  },
  async add(c3, params) {
    const { email: email4, type, password, regKeyId } = params;
    if (!c3.env.domain.includes(email_utils_default.getDomain(email4))) {
      throw new biz_error_default(t3("notEmailDomain"));
    }
    if (password.length < 6) {
      throw new biz_error_default(t3("pwdMinLength"));
    }
    const accountRow = await account_service_default.selectByEmailIncludeDel(c3, email4);
    if (accountRow && accountRow.isDel === isDel.DELETE) {
      throw new biz_error_default(t3("isDelUser"));
    }
    if (accountRow) {
      throw new biz_error_default(t3("isRegAccount"));
    }
    const role2 = role_service_default.selectById(c3, type);
    if (!role2) {
      throw new biz_error_default(t3("roleNotExist"));
    }
    const { salt, hash } = await crypto_utils_default.hashPassword(password);
    const userId = await userService.insert(c3, { email: email4, password: hash, salt, type, regKeyId: regKeyId || 0 });
    await userService.updateUserInfo(c3, userId, true);
