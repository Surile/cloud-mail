      toEmail: message.to,
      toName,
      sendEmail: email4.from.address,
      name: email4.from.name || email_utils_default.getName(email4.from.address),
      subject: email4.subject,
      code,
      content: email4.html,
      text: email4.text,
      cc: email4.cc ? JSON.stringify(email4.cc) : "[]",
      bcc: email4.bcc ? JSON.stringify(email4.bcc) : "[]",
      recipient: JSON.stringify(email4.to),
      inReplyTo: email4.inReplyTo,
      relation: email4.references,
      messageId: email4.messageId,
      userId: account2 ? account2.userId : 0,
      accountId: account2 ? account2.accountId : 0,
      isDel: isDel.DELETE,
      status: emailConst.status.SAVING
