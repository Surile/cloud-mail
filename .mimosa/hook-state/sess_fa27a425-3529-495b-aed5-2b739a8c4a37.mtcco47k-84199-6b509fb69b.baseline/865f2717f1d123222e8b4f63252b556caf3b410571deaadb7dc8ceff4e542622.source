// src/service/account-service.js
var accountService = {
  async add(c3, params, userId) {
    const { addEmailVerify, addEmail, manyEmail, addVerifyCount, minEmailPrefix, emailPrefixFilter } = await setting_service_default.query(c3);
    let { email: email4, token: token2 } = params;
    if (!(addEmail === settingConst.addEmail.OPEN && manyEmail === settingConst.manyEmail.OPEN)) {
      throw new biz_error_default(t3("addAccountDisabled"));
    }
    if (!email4) {
      throw new biz_error_default(t3("emptyEmail"));
    }
    if (!verify_utils_default.isEmail(email4)) {
      throw new biz_error_default(t3("notEmail"));
    }
    if (!c3.env.domain.includes(email_utils_default.getDomain(email4))) {
      throw new biz_error_default(t3("notExistDomain"));
    }
    if (email_utils_default.getName(email4).length < minEmailPrefix) {
      throw new biz_error_default(t3("minEmailPrefix", { msg: minEmailPrefix }));
    }
    if (emailPrefixFilter.some((content) => email_utils_default.getName(email4).includes(content))) {
      throw new biz_error_default(t3("banEmailPrefix"));
    }
    let accountRow = await this.selectByEmailIncludeDel(c3, email4);
    if (accountRow && accountRow.isDel === isDel.DELETE) {
      throw new biz_error_default(t3("isDelAccount"));
    }
    if (accountRow) {
      throw new biz_error_default(t3("isRegAccount"));
    }
    if (email4.includes("+")) {
      const baseEmail = email_utils_default.getBaseEmail(email4);
      const baseAccount = await this.selectByEmailIncludeDel(c3, baseEmail);
      if (!baseAccount || baseAccount.userId !== userId) {
        throw new biz_error_default(t3("notOwner"));
      }
    }
    const userRow = await user_service_default.selectById(c3, userId);
    const roleRow = await role_service_default.selectById(c3, userRow.type);
    if (userRow.email !== c3.env.admin) {
      if (roleRow.accountCount > 0) {
        const userAccountCount = await accountService.countUserAccount(c3, userId);
        if (userAccountCount >= roleRow.accountCount) throw new biz_error_default(t3("accountLimit"), 403);
      }
      if (!role_service_default.hasAvailDomainPerm(roleRow.availDomain, email4)) {
        throw new biz_error_default(t3("noDomainPermAdd"), 403);
      }
    }
    let addVerifyOpen = false;
    if (addEmailVerify === settingConst.addEmailVerify.OPEN) {
      addVerifyOpen = true;
      await turnstile_service_default.verify(c3, token2);
    }
    if (addEmailVerify === settingConst.addEmailVerify.COUNT) {
      addVerifyOpen = await verify_record_service_default.isOpenAddVerify(c3, addVerifyCount);
      if (addVerifyOpen) {
        await turnstile_service_default.verify(c3, token2);
      }
    }
    accountRow = await orm(c3).insert(account_default).values({ email: email4, userId, name: email_utils_default.getName(email4) }).returning().get();
    if (addEmailVerify === settingConst.addEmailVerify.COUNT && !addVerifyOpen) {
      const row = await verify_record_service_default.increaseAddCount(c3);
      addVerifyOpen = row.count >= addVerifyCount;
    }
    accountRow.addVerifyOpen = addVerifyOpen;
    return accountRow;
  },
  selectByEmailIncludeDel(c3, email4) {
    return orm(c3).select().from(account_default).where(sql`${account_default.email} COLLATE NOCASE = ${email4}`).get();
  },
  list(c3, params, userId) {
    let { accountId, size, lastSort } = params;
    accountId = Number(accountId);
    size = Number(size);
    lastSort = Number(lastSort);
    if (size > 30) {
      size = 30;
    }
    if (!accountId) {
      accountId = 0;
    }
    if (Number.isNaN(lastSort)) {
      lastSort = 9999999999;
    }
    return orm(c3).select().from(account_default).where(
      and(
        eq(account_default.userId, userId),
        eq(account_default.isDel, isDel.NORMAL),
        or(
          lt(account_default.sort, lastSort),
          and(
            eq(account_default.sort, lastSort),
            gt(account_default.accountId, accountId)
          )
        )
      )
    ).orderBy(desc(account_default.sort), asc(account_default.accountId)).limit(size).all();
  },
  async delete(c3, params, userId) {
    let { accountId } = params;
    const user2 = await user_service_default.selectById(c3, userId);
    const accountRow = await this.selectById(c3, accountId);
    if (accountRow.email === user2.email) {
      throw new biz_error_default(t3("delMyAccount"));
    }
    if (accountRow.userId !== user2.userId) {
      throw new biz_error_default(t3("noUserAccount"));
    }
    const { syncDelete } = await setting_service_default.query(c3);
    if (syncDelete === settingConst.syncDelete.OPEN) {
      await this.physicsDelete(c3, { accountId });
      return;
    }
    await orm(c3).update(account_default).set({ isDel: isDel.DELETE }).where(
      and(
        eq(account_default.userId, userId),
        eq(account_default.accountId, accountId)
      )
    ).run();
  },
  selectById(c3, accountId) {
    return orm(c3).select().from(account_default).where(
      and(
        eq(account_default.accountId, accountId),
        eq(account_default.isDel, isDel.NORMAL)
      )
    ).get();
  },
  async insert(c3, params) {
    await orm(c3).insert(account_default).values({ ...params }).returning();
  },
  async insertList(c3, list) {
    await orm(c3).insert(account_default).values(list).run();
  },
  async physicsDeleteByUserIds(c3, userIds) {
    await email_service_default.physicsDeleteUserIds(c3, userIds);
    await orm(c3).delete(account_default).where(inArray(account_default.userId, userIds)).run();
  },
  async selectUserAccountCountList(c3, userIds, del = isDel.NORMAL) {
    const result2 = await orm(c3).select({
      userId: account_default.userId,
      count: count(account_default.accountId)
    }).from(account_default).where(and(
      inArray(account_default.userId, userIds),
      eq(account_default.isDel, del)
    )).groupBy(account_default.userId);
    return result2;
  },
  async countUserAccount(c3, userId) {
    const { num } = await orm(c3).select({ num: count() }).from(account_default).where(and(eq(account_default.userId, userId), eq(account_default.isDel, isDel.NORMAL))).get();
    return num;
  },
  async restoreByEmail(c3, email4) {
    await orm(c3).update(account_default).set({ isDel: isDel.NORMAL }).where(eq(account_default.email, email4)).run();
  },
  async restoreByUserId(c3, userId) {
    await orm(c3).update(account_default).set({ isDel: isDel.NORMAL }).where(eq(account_default.userId, userId)).run();
  },
  async setName(c3, params, userId) {
    const { name: name2, accountId } = params;
    if (name2.length > 30) {
      throw new biz_error_default(t3("usernameLengthLimit"));
    }
    await orm(c3).update(account_default).set({ name: name2 }).where(and(eq(account_default.userId, userId), eq(account_default.accountId, accountId))).run();
  },
  async allAccount(c3, params) {
    let { userId, num, size } = params;
    userId = Number(userId);
    num = Number(num);
    size = Number(size);
    if (size > 30) {
      size = 30;
    }
    num = (num - 1) * size;
    const userRow = await user_service_default.selectByIdIncludeDel(c3, userId);
    const list = await orm(c3).select().from(account_default).where(and(eq(account_default.userId, userId), ne(account_default.email, userRow.email))).limit(size).offset(num);
    const { total } = await orm(c3).select({ total: count() }).from(account_default).where(eq(account_default.userId, userId)).get();
    return { list, total };
  },
  async physicsDelete(c3, params) {
    const { accountId } = params;
    await email_service_default.physicsDeleteByAccountId(c3, accountId);
    await orm(c3).delete(account_default).where(eq(account_default.accountId, accountId)).run();
  },
  async setAllReceive(c3, params, userId) {
    let a2 = null;
    const { accountId } = params;
    const accountRow = await this.selectById(c3, accountId);
    if (accountRow.userId !== userId) {
      return;
    }
    await orm(c3).update(account_default).set({ allReceive: accountConst.allReceive.CLOSE }).where(eq(account_default.userId, userId)).run();
    await orm(c3).update(account_default).set({ allReceive: accountRow.allReceive ? 0 : 1 }).where(eq(account_default.accountId, accountId)).run();
  },
  async setAsTop(c3, params, userId) {
    const { accountId } = params;
    const userRow = await user_service_default.selectById(c3, userId);
    const mainAccountRow = await accountService.selectByEmailIncludeDel(c3, userRow.email);
    let mainSort = mainAccountRow.sort === 0 ? 2 : mainAccountRow.sort + 1;
    await orm(c3).update(account_default).set({ sort: mainSort }).where(eq(account_default.email, userRow.email)).run();
    await orm(c3).update(account_default).set({ sort: mainSort - 1 }).where(and(eq(account_default.accountId, accountId), eq(account_default.userId, userId))).run();
  }
};
