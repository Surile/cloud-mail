var telegramService = {
  async getEmailContent(c3, params) {
    const { token: token2 } = params;
    const result2 = await jwt_utils_default.verifyToken(c3, token2);
    if (!result2) {
      return emailTextTemplate("Access denied");
    }
    const emailRow = await orm(c3).select().from(email_default).where(eq(email_default.emailId, result2.emailId)).get();
    if (emailRow) {
      if (emailRow.content) {
        const { r2Domain } = await setting_service_default.query(c3);
        return emailHtmlTemplate(emailRow.content || "", r2Domain);
      } else {
        return emailTextTemplate(emailRow.text || "");
      }
    } else {
      return emailTextTemplate("The email does not exist");
    }
  },
  async sendEmailToBot(c3, email4) {
    const { tgBotToken, tgChatId, customDomain, tgMsgTo, tgMsgFrom, tgMsgText } = await setting_service_default.query(c3);
    const tgChatIds = tgChatId.split(",");
    const jwtToken = await jwt_utils_default.generateToken(c3, { emailId: email4.emailId });
    const webAppUrl = customDomain ? `${domain_uitls_default.toOssDomain(customDomain)}/api/telegram/getEmail/${jwtToken}` : "https://www.cloudflare.com/404";
    const inlineKeyboard = [
      [
        {
          text: "View",
          web_app: { url: webAppUrl }
        }
      ]
    ];
    if (email4.code) {
      inlineKeyboard.push([
        {
          text: email4.code,
          copy_text: { text: email4.code }
        }
      ]);
    }
    await Promise.all(tgChatIds.map(async (chatId) => {
      try {
        const res = await fetch(`https://api.telegram.org/bot${tgBotToken}/sendMessage`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            chat_id: chatId,
            parse_mode: "HTML",
            text: emailMsgTemplate(email4, tgMsgTo, tgMsgFrom, tgMsgText),
            reply_markup: {
              inline_keyboard: inlineKeyboard
            }
          })
        });
        if (!res.ok) {
          console.error(`\u8F6C\u53D1 Telegram \u5931\u8D25 status: ${res.status} response: ${await res.text()}`);
        }
      } catch (e3) {
        console.error(`\u8F6C\u53D1 Telegram \u5931\u8D25:`, e3.message);
      }
    }));
  }
};
