  const result2 = await jwt_utils_default.verifyToken(c3, jwt);
  if (!result2) {
    throw new biz_error_default(t3("authExpired"), 401);
  }
  const { userId, token: token2 } = result2;
  const authInfo = await c3.env.kv.get(kv_const_default.AUTH_INFO + userId, { type: "json" });
  if (!authInfo) {
    throw new biz_error_default(t3("authExpired"), 401);
  }
  if (!authInfo.tokens.includes(token2)) {
    throw new biz_error_default(t3("authExpired"), 401);
  }
  const permIndex = requirePerms.findIndex((item) => {
    return path.startsWith(item);
  });
  if (permIndex > -1) {
    const permKeys = await perm_service_default.userPermKeys(c3, authInfo.user.userId);
    const userPaths = permKeyToPaths(permKeys);
    const userPermIndex = userPaths.findIndex((item) => {
      return path.startsWith(item);
    });
    if (userPermIndex === -1 && authInfo.user.email !== c3.env.admin) {
      throw new biz_error_default(t3("unauthorized"), 403);
    }
  }
  const refreshTime = (0, import_dayjs8.default)(authInfo.refreshTime).startOf("day");
  const nowTime = (0, import_dayjs8.default)().startOf("day");
  if (!nowTime.isSame(refreshTime)) {
    authInfo.refreshTime = (0, import_dayjs8.default)().toISOString();
    await user_service_default.updateUserInfo(c3, authInfo.user.userId);
    await c3.env.kv.put(kv_const_default.AUTH_INFO + userId, JSON.stringify(authInfo), { expirationTtl: constant_default.TOKEN_EXPIRE });
  }
  c3.set("user", authInfo.user);
  return await next();
});
function permKeyToPaths(permKeys) {
  const paths = [];
  for (const key2 of permKeys) {
    const routeList = premKey[key2];
    if (routeList && Array.isArray(routeList)) {
