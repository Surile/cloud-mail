      query2 = query2.where(like(reg_key_default.code, `${code}%`));
    }
    const regKeyList = await query2.orderBy(desc(reg_key_default.regKeyId)).all();
    const roleList = await role_service_default.roleSelectUse(c3);
    const today = toUtc().tz("Asia/Shanghai").startOf("day");
    regKeyList.forEach((regKeyRow) => {
      const index = roleList.findIndex((roleRow) => roleRow.roleId === regKeyRow.roleId);
      regKeyRow.roleName = index > -1 ? roleList[index].name : "";
