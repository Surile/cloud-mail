  async selectUserEmailCountList(c3, userIds, type, del = isDel.NORMAL) {
    const result2 = await orm(c3).select({
      userId: email_default.userId,
      count: count(email_default.emailId)
    }).from(email_default).where(and(
      inArray(email_default.userId, userIds),
      eq(email_default.type, type),
      eq(email_default.isDel, del),
      ne(email_default.status, emailConst.status.SAVING)
    )).groupBy(email_default.userId);
    return result2;
  },
  async allList(c3, params) {
    let { emailId, size, name: name2, subject, accountEmail, userEmail, type, timeSort, full } = params;
    size = Number(size);
    emailId = Number(emailId) || 0;
    timeSort = Number(timeSort);
    full = Number(full) === 1;
    if (size > 50) {
      size = 50;
    }
    const filters2 = this.allEmailListFilters({ emailId, name: name2, subject, accountEmail, userEmail, type, timeSort });
    const countFilters = this.allEmailListFilters({ emailId, name: name2, subject, accountEmail, userEmail, type, timeSort, withCursor: false });
    const columns = full ? emailListColumns : emailBriefColumns;
    const query2 = orm(c3).select({ ...columns, userEmail: user_default.email }).from(email_default).leftJoin(user_default, eq(email_default.userId, user_default.userId)).where(and(...filters2));
    const queryCount = userEmail ? orm(c3).select({ total: count() }).from(email_default).leftJoin(user_default, eq(email_default.userId, user_default.userId)).where(and(...countFilters)) : orm(c3).select({ total: count() }).from(email_default).where(and(...countFilters));
    if (timeSort) {
      query2.orderBy(asc(email_default.emailId));
    } else {
      query2.orderBy(desc(email_default.emailId));
    }
    const listQuery = query2.limit(size).all();
    const totalQuery = queryCount.get();
    const latestEmailQuery = orm(c3).select({
      emailId: email_default.emailId,
      accountId: email_default.accountId,
      userId: email_default.userId
    }).from(email_default).where(eq(email_default.type, emailConst.type.RECEIVE)).orderBy(desc(email_default.emailId)).limit(1).get();
    let [list, totalRow, latestEmail] = await Promise.all([listQuery, totalQuery, latestEmailQuery]);
    if (full) {
      await this.emailAddAtt(c3, list);
    } else {
      this.applyListText(list);
    }
    if (!latestEmail) {
      latestEmail = {
        emailId: 0,
        accountId: 0,
        userId: 0
      };
    }
    return { list, total: totalRow.total, latestEmail };
  },
  async allEmailLatest(c3, params) {
    const { emailId } = params;
    let list = await orm(c3).select({ ...emailBriefColumns, userEmail: user_default.email }).from(email_default).leftJoin(user_default, eq(email_default.userId, user_default.userId)).where(
      and(
        gt(email_default.emailId, emailId),
        eq(email_default.type, emailConst.type.RECEIVE)
      )
    ).orderBy(desc(email_default.emailId)).limit(20);
    return this.applyListText(list);
  },
  async emailAddAtt(c3, list) {
    const emailIds = list.map((item) => item.emailId);
    if (emailIds.length > 0) {
      const attList = await att_service_default.selectByEmailIds(c3, emailIds);
      list.forEach((emailRow) => {
        const atts = attList.filter((attRow) => attRow.emailId === emailRow.emailId);
        emailRow.attList = atts;
      });
    }
  },
  async restoreByUserId(c3, userId) {
    await orm(c3).update(email_default).set({ isDel: isDel.NORMAL }).where(eq(email_default.userId, userId)).run();
  },
  async completeReceive(c3, status, emailId) {
    return await orm(c3).update(email_default).set({
      isDel: isDel.NORMAL,
      status
    }).where(eq(email_default.emailId, emailId)).returning().get();
  },
  async completeReceiveAll(c3) {
    await c3.env.db.prepare(
      `UPDATE email
			 SET status = ${emailConst.status.RECEIVE}
			 WHERE status = ${emailConst.status.SAVING}
			   AND EXISTS (SELECT 1 FROM account WHERE account.account_id = email.account_id)`
    ).run();
    await c3.env.db.prepare(
      `UPDATE email
			 SET status = ${emailConst.status.NOONE}
			 WHERE status = ${emailConst.status.SAVING}`
    ).run();
  },
  async autoClean(c3) {
    const { autoCleanDays, autoCleanExclude } = await setting_service_default.query(c3);
    const days = Number(autoCleanDays);
    if (!days || days <= 0) {
      return;
    }
    const cutoff = (0, import_dayjs3.default)().subtract(days, "day").format("YYYY-MM-DD HH:mm:ss");
    const excludeEmails = String(autoCleanExclude || "").split(/[,，]/).map((item) => item.trim()).filter(Boolean);
    let excludeUserIds = [];
    if (excludeEmails.length) {
      const rows = await orm(c3).select({ userId: user_default.userId }).from(user_default).where(sql`lower(${user_default.email}) IN (${sql.join(excludeEmails.map((email4) => sql`${email4.toLowerCase()}`), sql`, `)})`).all();
      excludeUserIds = rows.map((row) => row.userId);
    }
    const batchSize = 95;
    while (true) {
      const conditions = [lt(email_default.createTime, cutoff)];
      if (excludeUserIds.length) {
        conditions.push(notInArray(email_default.userId, excludeUserIds));
      }
      const rows = await orm(c3).select({ emailId: email_default.emailId }).from(email_default).where(and(...conditions)).limit(batchSize).all();
      if (!rows.length) {
        break;
      }
      const emailIds = rows.map((row) => row.emailId);
      await this.physicsDelete(c3, { emailIds: emailIds.join(",") });
      if (rows.length < batchSize) {
        break;
      }
    }
  },
  async batchDelete(c3, params) {
    let { sendName, sendEmail, toEmail, subject, startTime, endTime, type } = params;
    let right2 = type === "left" || type === "include";
    let left2 = type === "include";
    const conditions = [];
    if (sendName) {
      conditions.push(like(email_default.name, `${left2 ? "%" : ""}${sendName}${right2 ? "%" : ""}`));
    }
    if (subject) {
      conditions.push(like(email_default.subject, `${left2 ? "%" : ""}${subject}${right2 ? "%" : ""}`));
    }
    if (sendEmail) {
      conditions.push(like(email_default.sendEmail, `${left2 ? "%" : ""}${sendEmail}${right2 ? "%" : ""}`));
    }
    if (toEmail) {
      conditions.push(like(email_default.toEmail, `${left2 ? "%" : ""}${toEmail}${right2 ? "%" : ""}`));
    }
    if (startTime && endTime) {
      conditions.push(gte(email_default.createTime, `${startTime}`));
      conditions.push(lte(email_default.createTime, `${endTime}`));
    }
    if (conditions.length === 0) {
      return;
    }
    const emailIdsRow = await orm(c3).select({ emailId: email_default.emailId }).from(email_default).where(conditions.length > 1 ? and(...conditions) : conditions[0]).all();
    const emailIds = emailIdsRow.map((row) => row.emailId);
    if (emailIds.length === 0) {
      return;
    }
    await att_service_default.removeByEmailIds(c3, emailIds);
    await orm(c3).delete(email_default).where(conditions.length > 1 ? and(...conditions) : conditions[0]).run();
  },
  async physicsDeleteByAccountId(c3, accountId) {
    await att_service_default.removeByAccountId(c3, accountId);
    await orm(c3).delete(email_default).where(eq(email_default.accountId, accountId)).run();
  },
  async read(c3, params, userId) {
    const { emailIds } = params;
    await orm(c3).update(email_default).set({ unread: emailConst.unread.READ }).where(and(eq(email_default.userId, userId), inArray(email_default.emailId, emailIds)));
