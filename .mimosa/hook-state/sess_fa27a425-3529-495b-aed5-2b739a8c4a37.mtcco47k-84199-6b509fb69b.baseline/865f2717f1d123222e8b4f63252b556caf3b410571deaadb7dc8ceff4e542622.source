// src/service/ai-service.js
init_modules_watch_stub();
var aiService = {
  async extractCode(c3, email4, options = {}) {
    if (!this.shouldExtractCode(options.aiCode, options.aiCodeFilter, email4)) {
      return "";
    }
    const ai2 = c3.env.ai;
    try {
      const subject = email4.subject || "";
      const text2 = email_utils_default.formatText(email4.text || "");
      const htmlText = email_utils_default.htmlToText(email4.html || "");
      const body = (htmlText || text2).slice(0, 6e3);
      if (!subject && !body) {
        return "";
      }
      const result2 = await ai2.run(c3.env.ai_model || "@cf/meta/llama-3.1-8b-instruct-fast", {
        messages: [
          {
            role: "system",
            content: 'You extract verification codes from emails. Return only JSON like {"code":"12345678"} or {"code":""}. The code must be 8 characters or fewer and must not contain spaces. If the code is longer than 8 characters or contains spaces, return {"code":""}. Do not explain.'
          },
          {
            role: "user",
            content: `Subject: ${subject}

${body}`
          }
        ],
        temperature: 0,
        max_tokens: 32
      });
      const content = typeof result2 === "string" ? result2 : result2?.response || "";
      const json = typeof content === "string" ? JSON.parse(content) : content;
      if (typeof json.code !== "string") {
        return "";
      }
      if (json.code.length > 8 || /\s/.test(json.code)) {
        return "";
      }
      return json.code;
    } catch (e3) {
      console.error("\u9A8C\u8BC1\u7801\u63D0\u53D6\u5931\u8D25: ", e3);
      return "";
    }
  },
  shouldExtractCode(aiCode, aiCodeFilterStr, email4) {
    if (aiCode !== settingConst.aiCode.OPEN) {
      return false;
    }
    const filterList = aiCodeFilterStr ? aiCodeFilterStr.split(",").map((item) => item.trim().toLowerCase()).filter(Boolean) : [];
    if (filterList.length === 0) {
      return true;
    }
    const fromEmail = (email4.from?.address || "").trim().toLowerCase();
    const fromDomain = email_utils_default.getDomain(fromEmail).toLowerCase();
    return filterList.some((item) => item === fromEmail || item === fromDomain);
  },
  // 申请单 AI 审核：一次调用同时判定前缀人格化与申请理由（智谱通道，接口地址/模型/密钥均在系统设置配置）
  // 返回 { prefixOk, decision, reason }；通道不可用或解析失败返回 null（调用方回落人工队列）
  async reviewApplication(c3, application, zhipu) {
    const key2 = String(zhipu && zhipu.key || "").trim();
    if (!key2) {
      return null;
    }
    try {
      const res = await fetch(this.zhipuEndpoint(zhipu) + "/chat/completions", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Authorization": "Bearer " + key2
        },
        body: JSON.stringify({
          model: zhipu && zhipu.model || "glm-4.7-flash",
          messages: this.reviewMessages(application),
          temperature: 0,
          max_tokens: 220,
          stream: false,
          thinking: { type: "disabled" }
        })
      });
      if (!res.ok) {
        console.error("\u667A\u8C31\u5BA1\u6838\u8BF7\u6C42\u5931\u8D25 status: " + res.status);
        return null;
      }
      const data = await res.json();
      return this.parseVerdict(data?.choices?.[0]?.message?.content || "");
    } catch (e3) {
      console.error("\u667A\u8C31 AI \u5BA1\u6838\u5931\u8D25: ", e3.message);
      return null;
    }
  },
  reviewMessages(application) {
    return [
      {
        role: "system",
        content: 'You are the admissions reviewer of a community mailbox service (a parody university). Evaluate TWO things and respond with ONLY one JSON object: {"prefix_ok":true,"decision":"approve","reason":"\u7528\u4E2D\u6587\u5199\u7684\u7B80\u77ED\u539F\u56E0"}. No markdown, no extra text.\n1) prefix_ok \u2014 does the desired email prefix look like something a real person would use as a personal address? OK examples: full pinyin name (wangxiaoming), given name, name plus initials (yxwang2001), western name (john.smith). NOT ok: gibberish, digit strings, brand/meme/celebrity names, offensive words.\n2) decision \u2014 judge the application reason: approve if it describes a plausible legitimate personal use (community membership, website registrations, daily mail); reject if gibberish, copy-pasted filler, spam, abusive, illegal or bad-faith; review when unsure. Leniency scales with trust level: trust 2 \u2014 be lenient when prefix_ok and the reason is plausible; trust 1 \u2014 moderate; trust 0 \u2014 strict, prefer review when unsure.\nThe reason field MUST always be written in Chinese (\u4E2D\u6587), regardless of the language of the application.\nIf Fast lane is true, ignore the reason completely: only set prefix_ok, and set decision to "approve".'
      },
      {
        role: "user",
        content: ["Fast lane: " + (application.fastLane ? "true" : "false"), "Prefix: " + (application.prefix || ""), "Platform: " + (application.platform || ""), "Username: " + (application.username || ""), "Trust level: " + (application.trustLevel ?? "unknown"), "Reason: " + (application.reason || "")].join("\n")
      }
    ];
  },
  parseVerdict(content) {
    const match2 = String(content || "").replace(/```/g, "").match(/\{[\s\S]*\}/);
    if (!match2) {
      return null;
    }
    try {
      const json = JSON.parse(match2[0]);
      const decision = String(json.decision || "").toLowerCase();
      if (!["approve", "reject", "review"].includes(decision)) {
        return null;
      }
      return {
        prefixOk: json.prefix_ok === true,
        decision,
        reason: String(json.reason || "").slice(0, 150)
      };
    } catch (e3) {
      return null;
    }
  },
  zhipuEndpoint(zhipu) {
    const url = String(zhipu && zhipu.baseUrl || "").trim().replace(/\/+$/, "");
    return url || "https://open.bigmodel.cn/api/paas/v4";
  },
  // 拉取智谱可用模型列表（管理端下拉用）；无 Key 或失败返回空数组
  async listZhipuModels(c3, zhipu) {
    const key2 = String(zhipu && zhipu.key || "").trim();
    if (!key2) {
      return [];
    }
    try {
      const res = await fetch(this.zhipuEndpoint(zhipu) + "/models", {
        headers: {
          "Authorization": "Bearer " + key2
        }
      });
      if (!res.ok) {
        console.error("\u83B7\u53D6\u667A\u8C31\u6A21\u578B\u5217\u8868\u5931\u8D25 status: " + res.status);
        return [];
      }
      const data = await res.json();
      return (data?.data || []).map((m2) => ({ id: m2.id || m2.model || "", owned_by: m2.owned_by || "" })).filter((m2) => m2.id);
    } catch (e3) {
      console.error("\u83B7\u53D6\u667A\u8C31\u6A21\u578B\u5217\u8868\u5931\u8D25: ", e3.message);
      return [];
    }
  }
};
var ai_service_default = aiService;

