      remark: applyRow.remark,
      updateTime: (0, import_dayjs6.default)().format("YYYY-MM-DD HH:mm:ss")
    }).where(eq(apply_default.applyId, applyRow.applyId)).run();
  },
  async mine(c3, params) {
    const verified = await this.verifyApplyToken(c3, params.token);
    const row = await orm(c3).select().from(apply_default).where(eq(apply_default.oauthUserId, verified.oauthRow.oauthUserId)).orderBy(desc(apply_default.applyId)).limit(1).get();
    if (!row) {
      return {};
    }
    const result2 = {
      email: row.email,
      status: row.status,
