    await user_service_default.updateUserInfo(c3, userRow.userId);
    await c3.env.kv.put(kv_const_default.AUTH_INFO + userRow.userId, JSON.stringify(authInfo), { expirationTtl: constant_default.TOKEN_EXPIRE });
    return jwt;
  },
  async logout(c3, userId) {
    const token2 = user_context_default.getToken(c3);
    const authInfo = await c3.env.kv.get(kv_const_default.AUTH_INFO + userId, { type: "json" });
