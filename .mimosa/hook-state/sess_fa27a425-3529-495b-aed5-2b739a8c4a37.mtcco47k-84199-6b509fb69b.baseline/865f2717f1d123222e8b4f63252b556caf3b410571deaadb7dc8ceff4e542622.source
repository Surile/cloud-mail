var publicService = {
  async emailList(c3, params) {
    let { toEmail, content, subject, sendName, sendEmail, timeSort, num, size, type, isDel: isDel2 } = params;
    const query2 = orm(c3).select({
      emailId: email_default.emailId,
      sendEmail: email_default.sendEmail,
      sendName: email_default.name,
      subject: email_default.subject,
      toEmail: email_default.toEmail,
      toName: email_default.toName,
      type: email_default.type,
      createTime: email_default.createTime,
      content: email_default.content,
      text: email_default.text,
      isDel: email_default.isDel
    }).from(email_default);
    if (!size) {
      size = 20;
    }
    if (!num) {
      num = 1;
    }
    size = Number(size);
    num = Number(num);
    num = (num - 1) * size;
    let conditions = [];
    if (toEmail) {
      conditions.push(sql`${email_default.toEmail} COLLATE NOCASE LIKE ${toEmail}`);
    }
    if (sendEmail) {
      conditions.push(sql`${email_default.sendEmail} COLLATE NOCASE LIKE ${sendEmail}`);
    }
    if (sendName) {
      conditions.push(sql`${email_default.name} COLLATE NOCASE LIKE ${sendName}`);
    }
    if (subject) {
      conditions.push(sql`${email_default.subject} COLLATE NOCASE LIKE ${subject}`);
    }
    if (content) {
      conditions.push(sql`${email_default.content} COLLATE NOCASE LIKE ${content}`);
    }
    if (type || type === 0) {
      conditions.push(eq(email_default.type, type));
    }
    if (isDel2 || isDel2 === 0) {
      conditions.push(eq(email_default.isDel, isDel2));
    }
    if (conditions.length === 1) {
      query2.where(...conditions);
    } else if (conditions.length > 1) {
      query2.where(and(...conditions));
    }
    if (timeSort === "asc") {
      query2.orderBy(asc(email_default.emailId));
    } else {
      query2.orderBy(desc(email_default.emailId));
    }
    return query2.limit(size).offset(num);
  },
  async addUser(c3, params) {
